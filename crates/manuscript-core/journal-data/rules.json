        {"id":"elsevier.interests","label":{"zhCn":"利益冲突声明","en":"Competing-interest statement"},"description":{"zhCn":"所有作者须披露相关利益；无利益时也要明确确认。系统将从已确认内容生成独立 Word 文件。","en":"All authors must disclose relevant interests or explicitly confirm that there are none. A separate Word file is generated from the confirmed statement."},"required":true,"kind":"fact","factKey":"conflict_of_interest","requiredFileKind":null,"evidence":{"sourceUrl":"https://www.sciencedirect.com/journal/artificial-intelligence/publish/guide-for-authors","label":{"zhCn":"官方作者指南：利益冲突","en":"Official guide: competing interests"},"verifiedAt":"2026-09-14"}},
