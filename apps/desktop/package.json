{
  "name": "@manuscriptdock/desktop",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "dev": "vite",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
